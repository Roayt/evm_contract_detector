# Telegram token from BotFather. Read, by monitor
Telegram_Token=

#ID of the Telegram chat where you want to receive alerts. Read, by the monitor.
Telegram_Chat_Id= 

#Database URL for the monitor to connect with database and run on your computer. Login:detector. Host:localhost
DATABASE_URL= 

#Password of the postgres admin user. Read, by the database
POSTGRES_PASSWORD= 

#Password of the detector role,which reads and writes. Read, by the database server 
DETECTOR_PASSWORD= 

#RPC endpoint of the chain to fetch data. Compose Passes ito the monitor 
RPC_URL= 

#Token symbol to watch for. Compose passes it to the monitor
SYMBOL= 

#Database url for the monitor inside Docker. Login: detector. Host:db Password: Same as DETECTOR_PASSWORD
DOCKER_DATABASE_URL= 

#Database url for the API when it runs on your computer. LoginP: api_reader. Host: localhost
DATABASE_API_URL= 

#Database API url for the API inside Docker. Login: api_reader. Host: db.Password: the same as API_READER_PASSWORD.
DOCKER_DATABASE_API_URL=

# Password of the api_reader role, only task is to read. Read by the database server
API_READER_PASSWORD= 
